# ローカル開発では、このファイルを `.env` にコピーして実値を設定してください。
# `VITE_` で始まる変数はブラウザへ公開されます。秘密鍵やサービスアカウント情報は設定しないでください。

# アプリ表示名: string（必須）
VITE_APP_NAME=MemoirAI

# Firebase Web App の公開クライアント設定: string（必須）
# Firebase Console > プロジェクトの設定 > マイアプリ > SDK の設定と構成 から取得します。
VITE_API_KEY=your_firebase_web_api_key
VITE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_PROJECT_ID=your-project-id
VITE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_APP_ID=your_firebase_app_id

# Firebase Analytics の Measurement ID: string（任意、現在はAnalytics未初期化）
VITE_MEASUREMENT_ID=your_measurement_id

# reCAPTCHA Enterprise のサイトキー: string（必須、公開用のサイトキー）
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=<your_recaptcha_enterprise_site_key>

# 絵日記画像生成モデル: enum（任意）
# 選択肢: gemini-3.1-flash-lite-image | gemini-3.1-flash-image | gemini-3-pro-image
# 未設定時: gemini-3.1-flash-lite-image
VITE_DIARY_IMAGE_MODEL=gemini-3.1-flash-lite-image

# 生成画像サイズ: enum（任意）
# 選択肢: 512 | 1K | 2K | 4K（モデルごとに対応サイズが異なります）
# 未設定時: 1K
VITE_DIARY_IMAGE_SIZE=1K
